# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: MySQL / PlanetScale / Upstash connection string for Prisma
# Example: mysql://user:password@host:3306/diaferastudio?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/diaferastudio"

# UPSTASH REDIS (Optional for serverless caching or rate limiting on Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ADMIN CREDENTIALS
ADMIN_DEFAULT_PASSWORD="admin123"
